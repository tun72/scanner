{
  "name": "food-scanner",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "eval:verdicts": "node --import tsx evals/verdicts/run.mjs",
    "release:check": "npm run release:check --workspace @food-scanner/mobile --",
    "test": "vitest run && npm run test:screens --workspace @food-scanner/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "overrides": {
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "expo-dev-client": "~58.0.21"
  }
}

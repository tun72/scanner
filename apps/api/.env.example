# Backend only
ANTHROPIC_API_KEY=
# Set FOOD_SCAN_PROVIDER=gemini and provide a Gemini key to use food-only recognition.
FOOD_SCAN_PROVIDER=
GEMINI_API_KEY=
OPEN_FOOD_FACTS_USER_AGENT=FoodScanner/0.1
# Set both to enable account login and cloud history.
DATABASE_URL=
CLOUDINARY_URL=
# Optional Web Push. Generate one stable VAPID key pair with web-push.
WEB_PUSH_SUBJECT=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Supply only to the one-time seed command.
SEED_USER_NAME=
SEED_USER_ROLL_NUMBER=
SEED_USER_PASSWORD=
# Admin portal. Use the exact issuer, a confidential OIDC client and an enforced MFA ACR from the provider.
# Register the HTTPS callback at ADMIN_ORIGIN/admin/auth/callback. Allowlist exact, stable subject IDs.
ADMIN_ORIGIN=
# Select password sign-in explicitly. Use a new, unique password of at least 15 characters.
# Leave empty to use the OIDC settings below.
ADMIN_AUTH_MODE=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_OIDC_ISSUER=
ADMIN_OIDC_CLIENT_ID=
ADMIN_OIDC_CLIENT_SECRET=
ADMIN_OIDC_MFA_ACR=
ADMIN_OIDC_SUBJECTS=

# Copy to .env.local and set the address of your Food Scanner API.
# This is public configuration that ships inside the app. Never put the Claude API key here.
#
# iOS simulator, with the API running on this computer:   http://localhost:3000
# Android emulator:                                       http://10.0.2.2:3000
# A real phone on the same Wi-Fi (Expo Go):                http://<this computer's local IP>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
# Set the published HTTPS policy URL for release builds.
# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://example.com/privacy
